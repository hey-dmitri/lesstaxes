# Copy to .env.local and fill in. .env.local is gitignored and must never be committed.
#
# Neither variable is needed for normal development or for the deployed site.
# They are only used when REFRESHING the dataset from upstream sources; all raw
# responses are committed under data/<version>/sources/, so every build script
# runs offline without them.

# Free, instant: https://api.census.gov/data/key_signup.html
# Used by scripts/build-housing-transport.mjs to fetch American Community Survey data.
CENSUS_API_KEY=

# BLS rejects automated requests whose User-Agent carries no contact address.
# Used when re-downloading Consumer Expenditure Survey tables.
DATA_CONTACT_EMAIL=
